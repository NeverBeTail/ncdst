{
  "entities": {
    "user": {
      "title": "User",
      "description": "App user profile",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "assignees": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["email", "name", "role"]
    },
    "merchant": {
      "title": "Merchant",
      "description": "Represents a merchant for NPay sales (Connect or Booking)",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "merchantType": { "type": "string", "enum": ["CONNECT", "BOOKING"] },
        "groupName": { "type": "string" },
        "name": { "type": "string" },
        "businessNumber": { "type": "string" },
        "address": { "type": "string" },
        "contact": { "type": "string" },
        "assignee": { "type": "string" },
        "visitDate": { "type": "string" },
        "visitResult": { "type": "string", "enum": ["대기중", "대표부재", "재방문필요", "상담희망", "즉시설치", "거절", "불가", "방문실패", ""] },
        "notes": { "type": "string" },
        "plannedDate": { "type": "string" },
        "vanCompany": { "type": "string" },
        "vanAgencyName": { "type": "string" },
        "agencyContact": { "type": "string" },
        "installStatus": { "type": "string", "enum": ["미설치", "설치예정", "설치완료", ""] },
        "installDate": { "type": "string" },
        "tTerminalInstalled": { "type": "string", "enum": ["설치", "미설치", "모름", ""] },
        "placeId": { "type": "string" },
        "bookingStatus": { "type": "string" },
        "category": { "type": "string" },
        "criteria": { "type": "string" },
        "no": { "type": "string" },
        "classification": { "type": "string" },
        "category2": { "type": "string" },
        "category3": { "type": "string" },
        "assignedPart": { "type": "string" },
        "leadOwner": { "type": "string" },
        "contactStage": { "type": "string" },
        "contactStatusNotes": { "type": "string" },
        "firstContactDate": { "type": "string" },
        "firstContactAssignee": { "type": "string" },
        "secondContactDate": { "type": "string" },
        "secondContactAssignee": { "type": "string" },
        "thirdContactDate": { "type": "string" },
        "thirdContactAssignee": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["merchantType", "groupName", "name", "address", "assignee", "visitResult"]
    },
    "userPlan": {
      "title": "User Plan",
      "description": "User specific visit plan for a merchant",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "merchantId": { "type": "string" },
        "plannedDate": { "type": "string" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["userId", "merchantId", "plannedDate"]
    },
    "settings": {
      "title": "Settings",
      "description": "Global app settings",
      "type": "object",
      "properties": {
        "assignees": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["assignees"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/user" },
      "description": "App user profiles and personal settings"
    },
    "merchants/{merchantId}": {
      "schema": { "$ref": "#/entities/merchant" },
      "description": "Target merchants for NPay Connect"
    },
    "userPlans/{planId}": {
      "schema": { "$ref": "#/entities/userPlan" },
      "description": "User personal visiting plans (plannedDate)"
    },
    "settings/{settingId}": {
      "schema": { "$ref": "#/entities/settings" },
      "description": "App settings like available assignees"
    }
  }
}

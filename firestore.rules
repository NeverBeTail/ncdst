rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && 
             request.auth.token.email_verified == true &&
             request.auth.token.email.matches('^.*@placen\\.co\\.kr$');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMerchantData(data) {
      return (!('groupName' in data) || (data.groupName is string && data.groupName.size() <= 500)) &&
             (!('vanCompany' in data) || (data.vanCompany is string && data.vanCompany.size() <= 500)) &&
             (!('vanAgencyName' in data) || (data.vanAgencyName is string && data.vanAgencyName.size() <= 500)) &&
             (!('agencyContact' in data) || (data.agencyContact is string && data.agencyContact.size() <= 200)) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 500)) &&
             (!('businessNumber' in data) || (data.businessNumber is string && data.businessNumber.size() <= 200)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 1000)) &&
             (!('assignee' in data) || (data.assignee is string && data.assignee.size() <= 200)) &&
             (!('visitDate' in data) || (data.visitDate is string && data.visitDate.size() <= 100)) &&
             (!('visitResult' in data) || (data.visitResult is string && data.visitResult in ['대기중', '대표부재', '재방문필요', '대리점상담희망', '즉시설치', '거절', '불가', '방문실패', ''])) &&
             (!('installStatus' in data) || (data.installStatus is string && data.installStatus in ['미설치', '설치예정', '설치완료', ''])) &&
             (!('installDate' in data) || (data.installDate is string && data.installDate.size() <= 100)) &&
             (!('tTerminalInstalled' in data) || (data.tTerminalInstalled is string && data.tTerminalInstalled in ['설치', '미설치', '모름', ''])) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000)) &&
             (!('contact' in data) || (data.contact is string && data.contact.size() <= 200)) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function hasAllMerchantFields(data) {
      let requiredFields = [
        'groupName', 'vanCompany', 'vanAgencyName', 'agencyContact', 'name', 
        'businessNumber', 'address', 'assignee', 'visitDate', 'visitResult', 
        'installStatus', 'installDate', 'tTerminalInstalled', 'notes', 'contact', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(requiredFields);
    }

    match /merchants/{merchantId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(merchantId) &&
                       isValidMerchantData(incoming()) &&
                       hasAllMerchantFields(incoming()) &&
                       incoming().keys().size() == 17 &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
                       isValidId(merchantId) &&
                       isValidMerchantData(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'groupName', 'vanCompany', 'vanAgencyName', 'agencyContact', 'name', 
                         'businessNumber', 'address', 'assignee', 'visitDate', 'visitResult', 
                         'installStatus', 'installDate', 'tTerminalInstalled', 'notes', 'contact', 'updatedAt'
                       ]);
      allow delete: if isSignedIn() && isValidId(merchantId);
    }

    function isValidSettings(data) {
      return (!('assignees' in data) || (data.assignees is list && (data.assignees.size() == 0 || data.assignees[0] is string))) &&
             (!('spreadsheetId' in data) || data.spreadsheetId is string);
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(settingId) && isValidSettings(incoming());
      allow update: if isSignedIn() && isValidId(settingId) && isValidSettings(incoming());
    }
  }
}

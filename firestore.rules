rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && 
             request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'kyungmin.lee@placen.co.kr';
    }

    function isActive() {
      return isSignedIn() && (isAdmin() || getUserData().status == 'active');
    }

    function isOwner(data) {
      return isSignedIn() && data.ownerId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMerchantData(data) {
      return (!('ownerId' in data) || (data.ownerId is string)) &&
             (!('ownerName' in data) || (data.ownerName is string)) &&
             (!('groupName' in data) || (data.groupName is string && data.groupName.size() <= 1000)) &&
             (!('merchantType' in data) || (data.merchantType is string && data.merchantType in ['CONNECT', 'BOOKING'])) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 1000)) &&
             (!('businessNumber' in data) || (data.businessNumber is string && data.businessNumber.size() <= 500)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 2000)) &&
             (!('contact' in data) || (data.contact is string && data.contact.size() <= 500)) &&
             (!('assignee' in data) || (data.assignee is string && data.assignee.size() <= 500)) &&
             (!('visitDate' in data) || (data.visitDate is string && data.visitDate.size() <= 200)) &&
             (!('visitResult' in data) || (data.visitResult is string && data.visitResult in ['대기중', '대표부재', '재방문필요', '상담희망', '즉시설치', '거절', '불가', '방문실패', '미처리', '기사용', ''])) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 10000)) &&
             (!('plannedDate' in data) || (data.plannedDate is string && data.plannedDate.size() <= 200)) &&
             (!('criteria' in data) || (data.criteria is string && data.criteria.size() <= 1000)) &&
             (!('no' in data) || (data.no is string && data.no.size() <= 500)) &&
             (!('classification' in data) || (data.classification is string && data.classification.size() <= 500)) &&
             (!('placeId' in data) || (data.placeId is string && data.placeId.size() <= 500)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 1000)) &&
             (!('category2' in data) || (data.category2 is string && data.category2.size() <= 1000)) &&
             (!('category3' in data) || (data.category3 is string && data.category3.size() <= 1000)) &&
             (!('assignedPart' in data) || (data.assignedPart is string && data.assignedPart.size() <= 1000)) &&
             (!('leadOwner' in data) || (data.leadOwner is string && data.leadOwner.size() <= 500)) &&
             (!('contactStage' in data) || (data.contactStage is string && data.contactStage.size() <= 500)) &&
             (!('contactStatusNotes' in data) || (data.contactStatusNotes is string && data.contactStatusNotes.size() <= 10000)) &&
             (!('firstContactDate' in data) || (data.firstContactDate is string && data.firstContactDate.size() <= 200)) &&
             (!('firstContactAssignee' in data) || (data.firstContactAssignee is string && data.firstContactAssignee.size() <= 500)) &&
             (!('secondContactDate' in data) || (data.secondContactDate is string && data.secondContactDate.size() <= 200)) &&
             (!('secondContactAssignee' in data) || (data.secondContactAssignee is string && data.secondContactAssignee.size() <= 500)) &&
             (!('thirdContactDate' in data) || (data.thirdContactDate is string && data.thirdContactDate.size() <= 200)) &&
             (!('thirdContactAssignee' in data) || (data.thirdContactAssignee is string && data.thirdContactAssignee.size() <= 500)) &&
             (!('vanCompany' in data) || (data.vanCompany is string && data.vanCompany.size() <= 1000)) &&
             (!('vanAgencyName' in data) || (data.vanAgencyName is string && data.vanAgencyName.size() <= 1000)) &&
             (!('agencyContact' in data) || (data.agencyContact is string && data.agencyContact.size() <= 500)) &&
             (!('installStatus' in data) || (data.installStatus is string && data.installStatus in ['미설치', '설치예정', '설치완료', '설치 예정', '설치 완료', ''])) &&
             (!('installDate' in data) || (data.installDate is string && data.installDate.size() <= 200)) &&
             (!('tTerminalInstalled' in data) || (data.tTerminalInstalled is string && data.tTerminalInstalled in ['설치', '미설치', '모름', ''])) &&
             (!('bookingStatus' in data) || (data.bookingStatus is string && data.bookingStatus.size() <= 500)) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function hasMinimumMerchantFields(data) {
      let requiredFields = ['merchantType', 'name', 'address', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredFields);
    }

    match /merchants/{merchantId} {
      allow read, list: if isActive();
      allow create: if isActive() &&
                       isValidId(merchantId) &&
                       isValidMerchantData(incoming()) &&
                       hasMinimumMerchantFields(incoming()) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isActive() &&
                       isValidId(merchantId) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /userPlans/{planId} {
      // planId format: {userId}_{merchantId}
      allow read: if isSignedIn() && (planId.startsWith(request.auth.uid) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isActive() && 
                    incoming().userId == request.auth.uid && 
                    planId == request.auth.uid + "_" + incoming().merchantId &&
                    (!('order' in incoming()) || incoming().order is number);
      allow update: if isActive() && 
                    incoming().userId == request.auth.uid && 
                    incoming().merchantId == existing().merchantId &&
                    (!('order' in incoming()) || (incoming().order is number));
      allow delete: if isSignedIn() && (planId.startsWith(request.auth.uid) || isAdmin());
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'assignees', 'updatedAt'])) ||
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasAny(['status', 'role', 'updatedAt']))
      );
    }

    match /merchants_audit/{logId} {
      allow read: if isActive();
      allow list: if isActive();
      allow create: if isActive() && isValidId(logId);
      allow update, delete: if false;
    }

    function isValidSettings(data) {
      return (!('assignees' in data) || (data.assignees is list && (data.assignees.size() == 0 || data.assignees[0] is string))) &&
             (!('spreadsheetId' in data) || data.spreadsheetId is string);
    }

    match /settings/{settingId} {
      allow read: if isActive();
      allow list: if isActive();
      allow create: if isActive() && isValidId(settingId) && isValidSettings(incoming());
      allow update: if isActive() && isValidId(settingId) && isValidSettings(incoming());
    }
  }
}
